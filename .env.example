# AshborneSDK Configuration

# API Configuration
API_KEY=your-api-key-here
HOST=0.0.0.0
PORT=8000

# Logging Configuration
LOG_LEVEL=INFO

# Output Formatter Configuration
WATERMARK_ENABLED=true
CONTENT_POLICY=moderate
VISIBLE_WATERMARK=false

# Persona Router Configuration
ROUTING_STRATEGY=context_aware

# License Enforcer Configuration
LICENSE_CACHE_TTL=3600

# Database Configuration (Optional)
# DATABASE_URL=postgresql://user:password@localhost/ashborne_sdk

# AWS Configuration (Optional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
